# ============================================================
# Navik Voiceover - Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to GitHub - it is in .gitignore.
# ============================================================

# --- REQUIRED: AI Vision (Script Generation) ---
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- OPTIONAL: Groq (free fallback when Gemini quota is exhausted) ---
# Get yours free at: https://console.groq.com/keys
GROQ_API_KEY=

# --- OPTIONAL: ElevenLabs (premium voices) ---
# Get yours at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# --- OPTIONAL: OpenAI ---
OPENAI_API_KEY=

# ============================================================
# Render Deployment Settings (set these in Render dashboard)
# ============================================================

# The public URL of your Render backend service.
# e.g. https://navik-voiceover.onrender.com
# This makes audio/video URLs absolute so Vercel frontend can access them.
BACKEND_URL=

# Vercel frontend URL - set to your Vercel domain to lock down CORS.
# e.g. https://navik-voiceover.vercel.app
# Leave blank to allow all origins (default for dev).
ALLOWED_ORIGIN=

# Render auto-sets PORT=10000. Do not change unless you know what you are doing.
PORT=10000

# Render ephemeral disk paths (auto-set by render.yaml)
UPLOADS_DIR=/tmp/uploads
OUTPUT_DIR=/tmp/output

# ============================================================
# Local Development Settings
# ============================================================
HOST=127.0.0.1
